# Copy to  functions/.env  (or .env.<your-project-id>)  and fill in. These are NOT secrets.
# The SMTP password is a secret and is set separately:  firebase functions:secrets:set SMTP_PASS
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=reminders@example.com
MAIL_FROM="Gradacus <reminders@example.com>"
# Optional: link shown at the bottom of each email
APP_URL=
# Used only for accounts that haven't saved a time zone yet (the app saves the browser's zone on every save)
DEFAULT_TIMEZONE=Asia/Dhaka
